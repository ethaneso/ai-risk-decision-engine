# Database Credentials
DB_USER=airisk
DB_PASSWORD=your_postgres_password_here
DB_NAME=airisk

DATABASE_URL=postgresql+psycopg://risk_user:risk_password@localhost:5432/risk_engine

# Embedding
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# RAG
TOP_K=10
RERANK_TOP_K=5

# Local LLM - Ollama
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DOCKER_BASE_URL=http://host.lima.internal:11434
OLLAMA_MODEL=llama3.2:3b

# ONLINE LLM
OPENAI_API_KEY=your_openai_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
